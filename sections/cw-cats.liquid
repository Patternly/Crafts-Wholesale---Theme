<div class="cw"><section class="cw-wrap cw-sec">
  {%- if section.settings.title != blank -%}<div class="cw-sechead"><h2 class="cw-h2">{{ section.settings.title | escape }}</h2></div>{%- endif -%}
  <div class="cw-cats">
    {%- for block in section.blocks -%}
      {%- assign col = block.settings.collection -%}
      {%- assign img = block.settings.image | default: col.featured_image -%}
      <a href="{{ block.settings.link | default: col.url | default: '#' }}" class="cw-card" {{ block.shopify_attributes }}>
        <span class="cw-card__img">
          {%- if img -%}{{ img | image_url: width: 600 | image_tag: loading: 'lazy', alt: '', sizes: '(min-width: 990px) 250px, 50vw' }}{%- else -%}<span class="cw-cats__ph">{%- render 'cw-icon', name: block.settings.icon, size: 64, stroke: 1.2 -%}</span>{%- endif -%}
        </span>
        <span class="cw-card__body">{{ block.settings.title | default: col.title | escape }}</span>
      </a>
    {%- endfor -%}
  </div>
</section></div>
{% schema %}
{
  "name": "CW categories",
  "max_blocks": 10,
  "settings": [ { "type": "text", "id": "title", "label": "Title", "default": "Shop by category" } ],
  "blocks": [
    { "type": "cat", "name": "Category", "settings": [
      { "type": "collection", "id": "collection", "label": "Collection" },
      { "type": "url", "id": "link", "label": "Link (empty = the collection)" },
      { "type": "image_picker", "id": "image", "label": "Picture (empty = collection picture)" },
      { "type": "text", "id": "title", "label": "Name (empty = collection name)" },
      { "type": "select", "id": "icon", "label": "Icon when there is no picture", "default": "kit", "options": [
        { "value": "kit", "label": "Kit box" }, { "value": "yarn", "label": "Yarn" }, { "value": "hoop", "label": "Hoop" }, { "value": "fabric", "label": "Fabric" }
      ] }
    ] }
  ],
  "presets": [ { "name": "CW categories", "blocks": [ { "type": "cat" }, { "type": "cat" }, { "type": "cat" }, { "type": "cat" }, { "type": "cat" } ] } ]
}
{% endschema %}
