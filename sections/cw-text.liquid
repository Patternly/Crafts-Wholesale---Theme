<div class="cw"><section class="cw-wrap cw-sec cw-sec--last">
  <div class="cw-text">
    {%- if section.settings.title != blank -%}<h2 class="cw-h2" style="margin-bottom:12px">{{ section.settings.title | escape }}</h2>{%- endif -%}
    <div class="rte">{{ section.settings.text }}</div>
    {%- if section.settings.button != blank -%}<p style="margin:18px 0 0"><a class="cw-btn cw-btn--navy" href="{{ section.settings.link }}">{{ section.settings.button | escape }}</a></p>{%- endif -%}
  </div>
</section></div>
{% schema %}
{
  "name": "CW text",
  "settings": [
    { "type": "text", "id": "title", "label": "Title" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "button", "label": "Button" },
    { "type": "url", "id": "link", "label": "Button link" }
  ],
  "presets": [ { "name": "CW text" } ]
}
{% endschema %}
