{%- capture cw_can -%}{%- render 'cw-can' -%}{%- endcapture -%}
{%- assign menu = linklists[section.settings.menu] -%}
<script>
  window.CW = Object.assign(window.CW || {}, {
    money: {{ shop.money_format | json }},
    min: {{ settings.cw_min_order | default: 0 | times: 100 | round | json }},
    can: {% if cw_can == 'yes' %}true{% else %}false{% endif %}
  });
</script>
<div class="cw">
  {%- if section.settings.show_topbar -%}
  <div class="cw-topbar">
    <div class="cw-wrap">
      <div class="cw-topbar__facts">
        {%- for block in section.blocks -%}
          <span {{ block.shopify_attributes }}{% if forloop.index > 2 %} class="cw-hide-m"{% endif %}>{{ block.settings.text }}</span>
        {%- endfor -%}
      </div>
      {%- if customer -%}
        <a href="{{ routes.account_url }}">My account</a>
      {%- else -%}
        <a href="{{ settings.cw_apply_url | default: '/pages/contact' }}">Apply for a trade account</a>
      {%- endif -%}
    </div>
  </div>
  {%- endif -%}

  <header class="cw-header{% if section.settings.sticky %} is-sticky{% endif %}">
    <div class="cw-wrap cw-header__row">
      <button type="button" class="cw-iconbtn" data-cw-menu aria-label="Menu" aria-controls="cw-drawer">{%- render 'cw-icon', name: 'menu', size: 22 -%}</button>
      <a href="{{ routes.root_url }}" class="cw-logo">
        {%- if section.settings.logo != blank -%}
          {{ section.settings.logo | image_url: width: 400 | image_tag: alt: shop.name, width: section.settings.logo_width }}
        {%- else -%}
          <span class="cw-logo__name">{{ shop.name | escape }}</span>
          {%- if section.settings.tagline != blank -%}<span class="cw-logo__sub">{{ section.settings.tagline | escape }}</span>{%- endif -%}
        {%- endif -%}
      </a>
      <form action="{{ routes.search_url }}" method="get" role="search" class="cw-search">
        {%- render 'cw-icon', name: 'search', size: 18 -%}
        <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search by name, SKU or barcode" aria-label="Search">
        <input type="hidden" name="options[prefix]" value="last">
        <input type="hidden" name="type" value="product">
      </form>
      <div class="cw-header__acts">
        {%- if cw_can == 'yes' and section.settings.quick_order_url != blank -%}
          <a href="{{ section.settings.quick_order_url }}" class="cw-btn cw-hide-m">{%- render 'cw-icon', name: 'list' -%}Quick order</a>
        {%- endif -%}
        {%- if customer -%}
          <a href="{{ routes.account_url }}" class="cw-btn" aria-label="My account">{%- render 'cw-icon', name: 'user' -%}<span class="cw-hide-m">{{ customer.default_address.company | default: customer.first_name | default: 'Account' | escape | truncate: 22 }}</span></a>
        {%- else -%}
          <a href="{{ routes.account_login_url }}" class="cw-btn" aria-label="Sign in">{%- render 'cw-icon', name: 'user' -%}<span class="cw-hide-m">Sign in</span></a>
        {%- endif -%}
        <a href="{{ routes.cart_url }}" class="cw-btn cw-btn--navy" id="cart-icon-bubble">{%- render 'cw-icon', name: 'bag' -%}<span data-cw-cart-total data-empty="Basket">{% if cart.item_count > 0 %}{{ cart.total_price | money }}{% else %}Basket{% endif %}</span></a>
      </div>
    </div>
    {%- if menu.links.size > 0 -%}
    <nav class="cw-wrap cw-nav" aria-label="Main categories">
      {%- for link in menu.links -%}
        {%- if link.links.size > 0 -%}
          <button type="button" class="cw-nav__link" data-cw-menu="{{ forloop.index }}" aria-controls="cw-drawer">{{ link.title | escape }}</button>
        {%- endif -%}
      {%- endfor -%}
    </nav>
    {%- endif -%}
  </header>

  <div class="cw-drawer" id="cw-drawer">
    <div class="cw-drawer__bg" data-cw-menu-close></div>
    <div class="cw-menu" role="dialog" aria-modal="true" aria-label="Menu">
      <div class="cw-menu__list">
        <div class="cw-menu__top">
          <a href="{{ routes.root_url }}" class="cw-logo__name" style="font-size:2.4rem;text-decoration:none">{{ shop.name | escape }}</a>
          <button type="button" class="cw-iconbtn cw-menu__x" data-cw-menu-close aria-label="Close menu">{%- render 'cw-icon', name: 'close', size: 22 -%}</button>
        </div>
        <nav class="cw-menu__links" aria-label="All pages">
          {%- for link in menu.links -%}
            {%- liquid
              assign t = link.title | downcase
              assign ic = ''
              if t contains 'cross' or t contains 'kit' or t contains 'embroider'
                assign ic = 'kit'
              elsif t contains 'yarn' or t contains 'thread' or t contains 'wool'
                assign ic = 'yarn'
              elsif t contains 'fabric' or t contains 'aida' or t contains 'evenweave'
                assign ic = 'fabric'
              elsif t contains 'storage' or t contains 'organi' or t contains 'hoop' or t contains 'frame' or t contains 'accessor'
                assign ic = 'hoop'
              endif
            -%}
            {%- if link.links.size > 0 -%}
              <button type="button" class="cw-menu__item" data-cw-pane="{{ forloop.index }}">
                {%- if ic != blank -%}{%- render 'cw-icon', name: ic, size: 20 -%}{%- endif -%}
                <span>{{ link.title | escape }}</span>
                <span class="cw-menu__chev">{%- render 'cw-icon', name: 'down', size: 16 -%}</span>
              </button>
            {%- else -%}
              <a class="cw-menu__item" href="{{ link.url }}">{%- if ic != blank -%}{%- render 'cw-icon', name: ic, size: 20 -%}{%- endif -%}<span>{{ link.title | escape }}</span></a>
            {%- endif -%}
          {%- endfor -%}
        </nav>
        <div class="cw-menu__foot">
          {%- if cw_can == 'yes' and section.settings.quick_order_url != blank -%}<a class="cw-menu__mini" href="{{ section.settings.quick_order_url }}">{%- render 'cw-icon', name: 'list', size: 18 -%}Quick order by SKU</a>{%- endif -%}
          {%- if customer -%}
            <a class="cw-menu__mini" href="{{ routes.account_url }}">{%- render 'cw-icon', name: 'reorder', size: 18 -%}My orders</a>
            <a class="cw-btn cw-btn--navy" href="{{ routes.account_url }}">My account</a>
          {%- else -%}
            <a class="cw-menu__mini" href="{{ settings.cw_apply_url | default: '/pages/contact' }}">{%- render 'cw-icon', name: 'doc', size: 18 -%}Apply for a trade account</a>
            <a class="cw-btn cw-btn--navy" href="{{ routes.account_login_url }}">Sign in</a>
          {%- endif -%}
        </div>
      </div>
      <div class="cw-menu__panes">
        {%- for link in menu.links -%}
          {%- if link.links.size > 0 -%}
            <section class="cw-menu__pane" data-pane="{{ forloop.index }}" hidden>
              <div class="cw-menu__head">
                <button type="button" class="cw-iconbtn cw-menu__back" data-cw-pane-back aria-label="Back to menu"><span style="transform:rotate(90deg);display:inline-flex">{%- render 'cw-icon', name: 'down', size: 20 -%}</span></button>
                <h2>{{ link.title | escape }}</h2>
                <a class="cw-btn cw-btn--teal" href="{{ link.url }}">Show all</a>
                <button type="button" class="cw-iconbtn cw-menu__xd" data-cw-menu-close aria-label="Close menu">{%- render 'cw-icon', name: 'close', size: 22 -%}</button>
              </div>
              <div class="cw-menu__tiles">
                {%- for c in link.links -%}
                  {%- liquid
                    assign img = blank
                    if c.type == 'collection_link'
                      assign img = c.object.featured_image
                    elsif c.type == 'product_link'
                      assign img = c.object.featured_image
                    endif
                  -%}
                  <a class="cw-menu__tile" href="{{ c.url }}">
                    <span class="cw-menu__pic">
                      {%- if img != blank -%}{{ img | image_url: width: 300 | image_tag: loading: 'lazy', alt: '', width: 150, height: 150 }}{%- else -%}<span class="cw-menu__ini">{{ c.title | slice: 0 | upcase }}</span>{%- endif -%}
                    </span>
                    <span class="cw-menu__name">{{ c.title | escape }}</span>
                  </a>
                {%- endfor -%}
              </div>
              {%- for c in link.links -%}
                {%- if c.links.size > 0 -%}
                  <div class="cw-menu__group">
                    <h3><a href="{{ c.url }}">{{ c.title | escape }}</a></h3>
                    <div>{%- for g in c.links -%}<a href="{{ g.url }}">{{ g.title | escape }}</a>{%- endfor -%}</div>
                  </div>
                {%- endif -%}
              {%- endfor -%}
            </section>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "CW header",
  "class": "cw-header-section",
  "max_blocks": 4,
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo (empty = shop name)" },
    { "type": "range", "id": "logo_width", "label": "Logo width", "min": 80, "max": 300, "step": 10, "unit": "px", "default": 190 },
    { "type": "text", "id": "tagline", "label": "Line under the name", "default": "Kits · Yarns · Supplies" },
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" },
    { "type": "text", "id": "quick_order_url", "label": "Quick order link", "default": "/cart#quick-order" },
    { "type": "checkbox", "id": "sticky", "label": "Stick to the top", "default": true },
    { "type": "checkbox", "id": "show_topbar", "label": "Show the dark top bar", "default": true }
  ],
  "blocks": [
    { "type": "fact", "name": "Top bar fact", "settings": [ { "type": "text", "id": "text", "label": "Text", "default": "Trade only" } ] }
  ],
  "presets": [ { "name": "CW header" } ]
}
{% endschema %}
